# ═══════════════════════════════════════════════════════════════════════════════
# XII CINEMA PLATFORM — Environment Variables
# Salin file ini menjadi .env lalu isi dengan nilai yang sesuai.
# JANGAN pernah commit file .env ke Git!
# ═══════════════════════════════════════════════════════════════════════════════

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# development | production | test
APP_NAME="XII Cinema API"
APP_URL=http://localhost:3000

# ─── Database (PostgreSQL Lokal) ──────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# Untuk PostgreSQL lokal default (user: postgres, port: 5432):
DATABASE_URL=postgresql://postgres:password@localhost:5432/xii_cinema_db

# Untuk Neon / Supabase / cloud, ganti dengan connection string yang diberikan:
# DATABASE_URL=postgresql://user:pass@host.neon.tech/xii_cinema_db?sslmode=require

# ─── JWT (JSON Web Token) ─────────────────────────────────────────────────────
# Gunakan string random yang panjang dan aman (minimal 32 karakter)
# Generate: openssl rand -hex 32
JWT_SECRET=ganti_dengan_string_random_panjang_dan_aman_minimal_32_karakter
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── QR Code Signing ──────────────────────────────────────────────────────────
# Secret khusus untuk signing QR code tiket (BERBEDA dari JWT_SECRET)
# Generate: openssl rand -hex 32
QR_SIGNING_SECRET=ganti_dengan_secret_khusus_untuk_qr_code_tiket

# ─── Midtrans Payment Gateway ─────────────────────────────────────────────────
# Daftar di: https://dashboard.midtrans.com
# Untuk development, gunakan Sandbox credentials
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false
# Ketika production, ganti ke: Mid-server-xxx dan Mid-client-xxx (tanpa SB-)

# ─── Cloudinary (Media Storage) ───────────────────────────────────────────────
# Daftar di: https://cloudinary.com (gratis 25GB)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_api_secret_here

# ─── Firebase (Push Notification) ────────────────────────────────────────────
# Buat project di: https://console.firebase.google.com
# Lalu: Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Catatan: private key mengandung \n, wrap dalam tanda kutip
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ─── Resend (Email Service) ───────────────────────────────────────────────────
# Daftar di: https://resend.com (gratis 3.000 email/bulan)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@xii.id
RESEND_FROM_NAME=XII Cinema

# ─── TMDB API (Opsional — Auto-fill metadata film) ───────────────────────────
# Daftar di: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Daftar origin yang diizinkan (pisahkan dengan koma, tanpa spasi)
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000
# Production: https://admin.xii.id,https://xii.id
